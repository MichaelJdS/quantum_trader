# ── API Token da aplicação ──────────────────────────────────────────────────
API_TOKEN=troque_por_um_token_seguro

# ── Deriv Platform ──────────────────────────────────────────────────────────
DERIV_API_TOKEN=seu_token_deriv_aqui
DERIV_WS_URL=wss://ws.binaryws.com/websockets/v3?app_id=1089

# ── Groq LLM (GroqAgent) ────────────────────────────────────────────────────
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT=8

# ── Gemini (opcional) ───────────────────────────────────────────────────────
GEMINI_ENABLED=false
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_CONSULT_INTERVAL_SECONDS=120

# ── Banco de dados ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./quantum_trader.db

# ── Configurações do bot ────────────────────────────────────────────────────
DEFAULT_SYMBOLS=R_50,R_75,R_100
DEFAULT_GRANULARITY=60
DEFAULT_STAKE=1.0
DRY_RUN=true

# ── Circuit Breaker ─────────────────────────────────────────────────────────
CIRCUIT_BREAKER_MAX_LOSSES=5
CIRCUIT_BREAKER_MAX_DRAWDOWN=0.15
CIRCUIT_BREAKER_COOLDOWN=1800

# ── Servidor ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
PORT=8080
HOST=0.0.0.0
